{
  "manifest_version": 3,
  "name": "PDF Generator with Lazy Loading Support",
  "version": "1.0",
  "description": "遅延読み込みされた画像を含めてPDFを生成するChrome拡張機能です。",
  "permissions": [
    "debugger",
    "downloads",
    "scripting",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PDFを生成"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
